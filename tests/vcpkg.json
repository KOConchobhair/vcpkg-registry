{
  "$comment": "Reference consumer manifest for this registry; see the top-level README for the reasoning behind every line of it.",
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "vcpkg-configuration": {
    "registries": [
      {
        "kind": "git",
        "baseline": "3ca77ed16a81d1a00d26d2a70b59b059ccdada1a",
        "repository": "https://github.com/KOConchobhair/vcpkg-registry",
        "packages": [
          "ffmpeg",
          "jetson-multimedia-api",
          "jetson-nvmpi",
          "libuv",
          "nvidia-cutlass",
          "opencv4",
          "qtbase"
        ]
      }
    ],
    "overlay-triplets": [
      "../triplets"
    ]
  },
  "name": "test",
  "builtin-baseline": "2cfff9c458d9dcf642e9fa09ba624f9931bb5358",
  "dependencies": [
    {
      "name": "amqpcpp",
      "platform": "!ios & !android"
    },
    {
      "name": "ffmpeg",
      "features": [
        "ffmpeg",
        "ffprobe",
        "openh264",
        {
          "name": "openssl",
          "platform": "linux | android"
        }
      ]
    },
    {
      "name": "libuv",
      "platform": "!ios & !android"
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "dnn",
        "features2d",
        "fs",
        "intrinsics",
        "jpeg",
        "openexr",
        "openjpeg",
        "png",
        "thread",
        "tiff",
        "webp"
      ]
    },
    "openssl",
    {
      "$comment": "Host qtbase (moc and the other build tools) on cross builds. default-features:false keeps the host off qtbase's full desktop default set - icu, libpq, the X11 stack - which the target entry's flag does not reach. thread is not optional though: Qt gates process on it (CONDITION QT_FEATURE_thread on UNIX), process gates the wasmdeployqt tool, and the target demands every tool it builds from the host package. Without it the android build dies with 'Failed to find the host tool Qt6::wasmdeployqt'.",
      "name": "qtbase",
      "host": true,
      "default-features": false,
      "features": [
        "thread"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "async-io",
        "concurrent",
        {
          "name": "dnslookup",
          "platform": "!ios"
        },
        {
          "name": "framework",
          "platform": "osx"
        },
        {
          "name": "ioring",
          "platform": "linux | windows"
        },
        "network",
        {
          "name": "openssl",
          "platform": "linux | android"
        },
        {
          "name": "openssl-runtime",
          "platform": "linux | android"
        },
        "pcre2",
        {
          "name": "schannel",
          "platform": "windows"
        },
        {
          "name": "securetransport",
          "platform": "osx | ios"
        }
      ]
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA support",
      "dependencies": [
        {
          "$comment": "CUTLASS for the CUDA engine (rank-1/rankone#4804). This registry serves it; its port needs only the CUDA toolkit.",
          "name": "nvidia-cutlass",
          "platform": "linux | (windows & x64)"
        },
        {
          "name": "ffmpeg",
          "features": [
            "nvcodec"
          ],
          "platform": "linux | windows"
        }
      ]
    },
    "gui": {
      "description": "Enable GUI support via Qt. Desktop only - internal tooling, never part of the shipped mobile package.",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "gui",
            "sql",
            "sql-sqlite",
            "widgets",
            "xml"
          ],
          "platform": "!ios & !android"
        }
      ]
    },
    "jetson": {
      "description": "Enable Jetson hardware video codecs (*_nvmpi) via this registry's jetson ports",
      "dependencies": [
        {
          "name": "ffmpeg",
          "features": [
            "nvmpi"
          ],
          "platform": "linux & arm64"
        }
      ]
    },
    "numa": {
      "description": "Enable NUMA-topology-aware search via libnuma",
      "dependencies": [
        {
          "name": "numactl",
          "platform": "linux"
        }
      ]
    },
    "prometheus": {
      "description": "Enable Prometheus metrics via prometheus-cpp",
      "dependencies": [
        {
          "name": "prometheus-cpp",
          "default-features": false
        }
      ]
    },
    "sentry": {
      "$comment": "Same as rankone's ci/vcpkg.json sentry feature, so CI prebuilds what that manifest resolves.",
      "description": "Enable Sentry crash and error reporting via sentry-native",
      "dependencies": [
        "sentry-native",
        {
          "$comment": "sentry-native requests curl without default features; ensure a TLS backend for event uploads.",
          "name": "curl",
          "default-features": false,
          "features": [
            "ssl"
          ],
          "platform": "!windows"
        }
      ]
    }
  },
  "overrides": [
    {
      "$comment": "Exactly 4.8.0: rankone's cuda/CMakeLists.txt asks find_package(NvidiaCutlass 4.8.0 EXACT), because its kernel choices and test tolerances were validated against it. The registry's baseline is 4.8.1#1.",
      "name": "nvidia-cutlass",
      "version": "4.8.0",
      "port-version": 1
    },
    {
      "name": "protobuf",
      "version": "3.19.4"
    }
  ]
}
